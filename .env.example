# ── Supabase ────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres password (Project Settings → Database), used for migrations
SUPABASE_DB_PASSWORD=

# ── AI providers ────────────────────────────────────────────────────────
# Anthropic: enrichment, rationales, briefing notes, sourcing
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# OpenAI: embeddings only (text-embedding-3-small, 1536 dims)
OPENAI_API_KEY=

# ── Internal dashboard ──────────────────────────────────────────────────
# Comma-separated email allowlist for dashboard sign-in
DASHBOARD_ALLOWLIST_EMAILS=

# ── Web search for demand-driven sourcing ───────────────────────────────
# Optional but STRONGLY recommended: without a key, sourcing falls back to
# Anthropic's built-in web_search tool, which searches sequentially and
# takes many minutes. With a key we fire queries in parallel — seconds.
# Set ONE of these (checked in this order).
BING_SEARCH_API_KEY=
# Only if the Bing key belongs to a Custom Search instance:
BING_CUSTOM_CONFIG_ID=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────
# Webhook notified when nightly scrape failures spike
SCRAPE_ALERT_WEBHOOK_URL=
# Claim-flow verification emails (Resend). Without these, codes are
# printed to the server log — fine for local development.
RESEND_API_KEY=
EMAIL_FROM=
